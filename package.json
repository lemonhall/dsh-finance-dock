{
  "name": "dsh-finance-dock",
  "version": "0.1.0",
  "description": "DSH 右侧栏的金融终端：跨资产监视列表（股指/商品/汇率/加密/利率），带 sparkline 与自动刷新，行情经宿主中转（免 key、走本机代理）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "finance",
    "market",
    "sidebar",
    "ticker"
  ],
  "author": "lemonhall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonhall/dsh-finance-dock.git"
  },
  "homepage": "https://github.com/lemonhall/dsh-finance-dock#readme",
  "bugs": {
    "url": "https://github.com/lemonhall/dsh-finance-dock/issues"
  },
  "meta": {
    "title": "金融终端",
    "description": "右侧栏一个 tab：跨资产行情监视列表，涨跌幅 + 迷你走势图，自动刷新；监视列表在配置里改。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
