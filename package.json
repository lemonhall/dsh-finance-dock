{
  "name": "dsh-finance-dock",
  "version": "0.2.0",
  "description": "DSH 右侧栏的金融终端：跨资产行情 + 会转的地球 + 风险偏好读数 + 中文说明 + 相关资讯，并且能和 Agent 双向对话（finance_panel 工具）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "finance",
    "market",
    "sidebar",
    "ticker",
    "three.js",
    "globe"
  ],
  "author": "lemonhall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonhall/dsh-finance-dock.git"
  },
  "homepage": "https://github.com/lemonhall/dsh-finance-dock#readme",
  "bugs": {
    "url": "https://github.com/lemonhall/dsh-finance-dock/issues"
  },
  "meta": {
    "title": "金融终端",
    "description": "右侧栏一个 tab：13 类 48 个标的的行情、3D 地球、风险偏好读数、中文说明与相关资讯；点一下标的，地球会转过去停下 10 秒。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
